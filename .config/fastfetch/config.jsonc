{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/Shuu/.config/fastfetch/arch_logo.txt",
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " 󰄾 "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "cyan",
            "format": "Arch"
        },
        {
            "type": "host",
            "key": "󰌢 Host",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": " CPU",
            "keyColor": "cyan"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU",
            "keyColor": "cyan"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory",
            "keyColor": "cyan"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[36m󰮯  \u001b[32m󰊠  \u001b[33m󰊠  \u001b[31m󰊠  \u001b[35m󰊠  \u001b[34m󰊠  \u001b[37m󰊠"
        }
    ]
}
